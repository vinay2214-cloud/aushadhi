# ============================================================
# AUSHADHI — Environment Variables
# Copy to .env (backend) and frontend/.env.local
# NEVER commit .env or .env.local to git
# ============================================================

# ---- BACKEND (.env in backend/) ----
# ACTIVE AUTH PATH: Gemini runs on Vertex AI, authenticated with Application
# Default Credentials. These two values are what the Gemini client is built
# from (project + location) — no API key is involved.
GOOGLE_CLOUD_PROJECT=aushadhi-hackathon
GOOGLE_CLOUD_REGION=us-central1
# Vertex AI endpoint serving the model. gemini-3.5-flash is only on "global" —
# regional endpoints (us-central1 etc.) return 404 NOT_FOUND for it.
VERTEX_LOCATION=global

# Only needed for AI Studio mode — NOT used in Vertex AI mode (current setup).
# The AI Studio free tier caps at 20 requests/day regardless of billing, which a
# single sentinel cycle can exhaust; Vertex AI bills the project with no daily cap.
# Key from https://aistudio.google.com/app/apikey — keys are no longer always
# "AIzaSy..." format, copy exactly what AI Studio gives you.
GOOGLE_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_TOKENS=8192
# Free-tier AI Studio allows 5/min; Vertex AI allows far more.
GEMINI_MAX_REQUESTS_PER_MINUTE=5

# Internal API key (generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
AUSHADHI_API_KEY=your-generated-secret-key-here

# Firestore
FIRESTORE_DATABASE_ID=(default)

# Pub/Sub topic prefix
PUBSUB_TOPIC_PREFIX=aushadhi

# GCP auth — ACTIVE AUTH PATH for Firestore, Pub/Sub, and Vertex AI Gemini.
# Local dev only; Cloud Run uses its service account automatically. Alternatively
# run: gcloud auth application-default login && \
#      gcloud auth application-default set-quota-project $GOOGLE_CLOUD_PROJECT
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Agent settings
SENTINEL_POLL_INTERVAL_MINUTES=30
CRITICAL_THRESHOLD_PERCENTAGE=15
LOW_THRESHOLD_PERCENTAGE=30
OUTBREAK_DETECTION_WINDOW_DAYS=7
USE_GEMMA_FALLBACK=false
GEMMA_MODEL=gemma-2-9b-it

# App settings
RUN_MODE=api              # "api" or "agents"
LOG_LEVEL=INFO
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ---- FRONTEND (frontend/.env.local) ----
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=your-generated-secret-key-here
VITE_APP_NAME=AUSHADHI
VITE_MAP_DEFAULT_LAT=16.9891    # Kakinada, East Godavari
VITE_MAP_DEFAULT_LNG=82.2475
VITE_MAP_DEFAULT_ZOOM=9
VITE_SSE_RECONNECT_DELAY=3000
